{
  // Merge this fragment into the Wrangler configuration generated by the
  // Nuxt/Nitro Cloudflare build. nuxt.config.ts generates the executable
  // .output/server/wrangler.json with these same values.
  "compatibility_date": "2026-08-29",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "leonardoprasetyo-prod",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOB",
      "bucket_name": "leonardoprasetyo-uploads-prod"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "leonardoprasetyo-documents-prod"
    }
  ],
  "workflows": [
    {
      "binding": "INDEXING_WORKFLOW",
      "name": "leonardoprasetyo-library-indexing-prod",
      "class_name": "LibraryIndexingWorkflow",
      "concurrency": {
        "limit": 1
      }
    }
  ],
  "vars": {
    "APP_ENVIRONMENT": "prod",
    "ACTIVITY_DATABASE_NAME": "leonardoprasetyo-prod",
    "LANGSMITH_TRACING": "true",
    "LANGSMITH_PROJECT": "leonardo-chat-prod",
    "LANGSMITH_ENDPOINT": "https://api.smith.langchain.com",
    "AI_GATEWAY_ID": "leonardoprasetyo",
    "CHAT_MODEL": "@cf/ibm-granite/granite-4.0-h-micro",
    "EMBEDDING_PROVIDER": "workers-ai",
    "EMBEDDING_MODEL": "@cf/qwen/qwen3-embedding-0.6b",
    "EMBEDDING_DIMENSIONS": "1024",
    "VECTORIZE_INDEX_NAME": "leonardoprasetyo-documents-prod",
    "VECTORIZE_METRIC": "cosine",
    "QUESTION_DAILY_LIMIT": "5"
  },
  "triggers": {
    "crons": ["17 0 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
