# Password for nuxt-auth-utils (minimum 32 characters)
NUXT_SESSION_PASSWORD=
# GitHub OAuth application for /admin. Use callback
# http://localhost:8787/auth/github when running pnpm dev:local.
# GitHub OAuth client ID
NUXT_OAUTH_GITHUB_CLIENT_ID=
# GitHub OAuth client secret
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
# Cloudflare-hosted Workers AI models use the Worker AI binding and do not
# require OpenAI, Google, or other provider API keys.
# HMAC secret for the anonymous IP quota (use at least 32 random bytes)
IP_HASH_SECRET=
# Bearer token for private Library administration (use at least 32 random bytes)
LIBRARY_ADMIN_TOKEN=
# Development-only LangSmith service key. Production uses a separate encrypted
# LANGSMITH_API_KEY secret on the leonardoprasetyo Worker.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=leonardo-chat-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Cloudflare provisioning/CI credentials (not Worker runtime secrets)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NUXT_HUB_CLOUDFLARE_DATABASE_ID=
# Remote D1 database paired with the development Vectorize index
NUXT_HUB_CLOUDFLARE_DEV_DATABASE_ID=
# Non-secret Cloudflare Worker configuration
AI_GATEWAY_ID=leonardoprasetyo
CHAT_MODEL=@cf/zai-org/glm-5.3-flash
EMBEDDING_PROVIDER=workers-ai
EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
EMBEDDING_DIMENSIONS=1024
VECTORIZE_INDEX_NAME=leonardoprasetyo-documents-prod
# `pnpm dev:local` binds this fixed development index remotely while keeping
# D1 and R2 on their remote development resources as well.
VECTORIZE_DEV_INDEX_NAME=leonardoprasetyo-documents-dev
VECTORIZE_METRIC=cosine
QUESTION_DAILY_LIMIT=5
# Blob read write token
BLOB_READ_WRITE_TOKEN=
# Turso database URL (not needed for local development)
TURSO_DATABASE_URL=
# Turso auth token (not needed for local development)
TURSO_AUTH_TOKEN=
